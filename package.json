{
  "type": "module",
  "name": "medusa-core",
  "version": "2.0.0",
  "description": "Node.js samples for [Google Workspace docs](https://developers.google.com/workspace/).",
  "license": "MIT",
  "author": "Grant Timmerman",
  "keywords": [
    "Google Workspace",
    "Apps Script",
    "Calendar",
    "Drive",
    "Sheets",
    "Slides",
    "API"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "tsx": "^4.22.4",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write",
    "test": "turbo run test",
    "check": "turbo run check",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "googleapis-common": "catalog:",
      "google-auth-library": "catalog:"
    }
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "googleapis": "catalog:",
    "helmet": "^8.2.0",
    "winston": "^3.19.0"
  }
}